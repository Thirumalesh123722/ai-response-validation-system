GROQ_API_KEY=your_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
CHROMA_PERSIST_DIR=./data/chroma
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Postgres connection string. For local dev, point at a local Postgres.
# For production, use a managed provider (Neon, Supabase, Railway, etc.)
DATABASE_URL=postgresql://postgres:testpass@localhost:5432/ai_eval_test

# JWT secret — MUST be changed to a long random value in production.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-only-secret-change-me-before-deploying
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
